    "release:json": "node scripts/build-latest-json.mjs",
    "version:set": "node scripts/version.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
