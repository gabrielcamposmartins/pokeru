    "server:build": "node scripts/build-server.mjs",
    "cert": "node scripts/cert.mjs",
    "server:start": "node dist-server/server/index.js",
    "test": "vitest run",
    "prepare:characters": "node scripts/prepare-characters.mjs",
    "build:falas": "node scripts/build-falas.mjs",
    "audios:faltando": "node scripts/audios-faltando.mjs",
