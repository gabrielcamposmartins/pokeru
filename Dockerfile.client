# ---------------------------------------------------------------------------
# Servidor web do cliente PokerSoul (a interface, servida por nginx)
#
#   docker build -f Dockerfile.client -t pokersoul-client .
#   docker run -p 8080:80 -e POKERSOUL_SERVER_URL=ws://meu-host:3001 pokersoul-client
#
# O endereço do servidor de jogo é definido na hora de subir (não no build):
# o entrypoint escreve /config.js e o cliente usa como padrão.
# ---------------------------------------------------------------------------

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# opcional: deixa um endereço embutido já no build (o config.js ainda tem prioridade)
ARG VITE_SERVER_URL=""
ENV VITE_SERVER_URL=$VITE_SERVER_URL
RUN npm run build

FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# o nginx roda os scripts de /docker-entrypoint.d antes de subir
COPY docker/client-entrypoint.sh /docker-entrypoint.d/40-pokersoul-config.sh
# tira o retorno de carro: o build pode vir de um checkout com quebras de linha do Windows,
# e aí o shell do contêiner não roda o script ("bad interpreter")
RUN sed -i 's/\r$//' /docker-entrypoint.d/40-pokersoul-config.sh && chmod +x /docker-entrypoint.d/40-pokersoul-config.sh
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
